{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfectpixel.local/schemas/agent-capability-manifest-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocolVersion", "behaviorVersion", "implementationVersion", "capabilities"],
  "properties": {
    "schema": {"const": "perfectpixel.agent-image/2"},
    "protocolVersion": {"const": "2.0.0"},
    "behaviorVersion": {"const": "2.0.0"},
    "implementationVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "determinism"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9._-]{1,128}$"},
          "version": {"type": "string", "minLength": 1, "maxLength": 64},
          "determinism": {"enum": ["bit_exact", "backend_deterministic", "inference_observed"]}
        }
      }
    }
  }
}
